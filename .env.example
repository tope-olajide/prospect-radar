[TEMPLATE]
# Created by `npx convex dev` when a deployment is linked.
VITE_CONVEX_URL=

# Set only in the Convex deployment environment, never in the client.
#
# ── LLM (OpenAI-compatible) ─────────────────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint works.
#
# OpenAI (default when OPENAI_BASE_URL is unset):
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini
#
# DashScope (Alibaba Qwen) — international endpoint:
# OPENAI_API_KEY=sk-...                       (your DashScope API key)
# OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
#
# DashScope (China/Beijing endpoint):
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
#
# Other Qwen models: qwen-turbo, qwen-max, qwen3-235b-a22b, ...
# OPENAI_API_KEY must always be set; OPENAI_BASE_URL and OPENAI_MODEL are optional.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Firecrawl (public-web search/scrape)
# FIRECRAWL_API_KEY=

# AgentMail (inbox, sending, delivery, webhooks)
# AGENTMAIL_API_KEY=
# AGENTMAIL_WEBHOOK_SECRET=
